{
  "manifest_version": 3,
  "name": "OtpPilot",
  "version": "0.1.4",
  "description": "Retrieve fresh OTPs from one user-authorized Gmail account.",
  "icons": {
    "16": "icons/otppilot-16.png",
    "32": "icons/otppilot-32.png",
    "48": "icons/otppilot-48.png",
    "128": "icons/otppilot-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "replace-with-your-unique-id@example.invalid",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personalCommunications",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "permissions": ["storage", "identity", "clipboardWrite", "scripting"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "scripts": ["src/background/service-worker.js"],
    "type": "module"
  },
  "action": { "default_title": "OtpPilot", "default_icon": "icons/otppilot-32.png", "default_popup": "src/popup/index.html" },
  "options_ui": { "page": "src/options/index.html", "open_in_tab": true }
}
