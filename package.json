{
  "name": "otppilot-browser-extension",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test --test-isolation=none",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build": "node scripts/build.js chrome firefox",
    "package:firefox": "npm run build:firefox && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-firefox.ps1"
  }
}
